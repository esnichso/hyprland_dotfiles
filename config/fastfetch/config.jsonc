{
  // Full layout — the one you get in a maximised terminal.
  //
  // fastfetch has no responsive mode. A config commits to a logo and a module
  // list, and if (logo width + key column + longest value) exceeds the
  // terminal width the result is mangled. Three configs live here and
  // fish/functions/fastfetch.fish picks between them by $COLUMNS.
  //
  // Widths are measured, not guessed. The built-in `cachyos` ASCII logo is
  // 54 columns wide and 22 lines tall; with the padding below that is 58
  // columns before any text starts. Key column 15, longest value ~35.
  // Needs about 108 columns.
  //
  // Colours are ANSI names on purpose. They resolve to kitty's palette, which
  // install/set-theme.py already generates — so fastfetch follows the theme
  // with nothing generated into this file.
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "builtin",
    "source": "cachyos",
    "padding": { "left": 1, "right": 3 }
  },

  "display": {
    "separator": "  ",
    "color": {
      "keys": "blue",
      "title": "magenta"
    },
    // 13 = len("Terminal Font"), the longest key below. Fixed rather than 0
    // (unaligned) so the value column starts at a width we can add up.
    "key": {
      "type": "both",
      "width": 13
    }
  },

  // 22 logo lines, 21 module lines. Roughly matched so the logo does not
  // trail off below the text (logo.printRemaining defaults to true).
  "modules": [
    "title",
    { "type": "separator", "string": "─", "times": 40 },

    { "type": "os", "key": "OS", "keyIcon": "" },
    { "type": "kernel", "key": "Kernel", "keyIcon": "" },
    { "type": "uptime", "key": "Uptime", "keyIcon": "" },
    { "type": "packages", "key": "Packages", "keyIcon": "" },
    { "type": "shell", "key": "Shell", "keyIcon": "" },

    "break",

    { "type": "wm", "key": "WM", "keyIcon": "" },
    { "type": "terminal", "key": "Terminal", "keyIcon": "" },
    { "type": "terminalfont", "key": "Terminal Font", "keyIcon": "" },
    { "type": "theme", "key": "Theme", "keyIcon": "" },
    { "type": "icons", "key": "Icons", "keyIcon": "" },

    "break",

    { "type": "cpu", "key": "CPU", "keyIcon": "" },
    { "type": "gpu", "key": "GPU", "keyIcon": "", "format": "{name} ({type})" },
    { "type": "memory", "key": "Memory", "keyIcon": "" },
    { "type": "disk", "key": "Disk", "keyIcon": "", "folders": "/" },
    // Absent in a VM, so this module simply prints nothing there.
    { "type": "battery", "key": "Battery", "keyIcon": "" },

    "break",

    { "type": "colors", "symbol": "circle" }
  ]
}
