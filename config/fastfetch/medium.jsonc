{
  // Half-screen layout — a vertical split on the 2560x1600 panel is around
  // 68 columns, which is nowhere near config.jsonc's 118.
  //
  // The built-in `cachyos_small` art is 24 columns and 11 lines; fastfetch
  // selects it with logo.type "small" rather than by name. 24 + 4 padding +
  // 8 key field + 30 value ("Intel(R) Core(TM) Ultra 7 255H", trimmed to
  // {name}) is 66 columns, so this is used from 68 up.
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    // "small", not "builtin" — the small variants are not separately
    // addressable by name, they are a flag on the parent logo.
    "type": "small",
    "source": "cachyos",
    "padding": { "left": 1, "right": 3 }
  },

  "display": {
    // See config.jsonc: empty separator, gap comes from key.width, which
    // truncates rather than only padding.
    "separator": "",
    "color": {
      "keys": "blue",
      "title": "magenta"
    },
    // 8 = len("Kernel") + 2.
    "key": {
      "type": "string",
      "width": 8
    }
  },

  // 11 logo lines, 13 module lines — the logo ends slightly above the text
  // rather than dangling below it.
  "modules": [
    "title",
    { "type": "separator", "string": "─", "times": 32 },

    { "type": "os", "key": "OS" },
    { "type": "kernel", "key": "Kernel", "format": "{release}" },
    { "type": "uptime", "key": "Up" },
    { "type": "packages", "key": "Pkgs" },
    { "type": "wm", "key": "WM" },

    "break",

    // {name} only: the default appends core count and frequency, which is
    // 15 columns this layout does not have.
    { "type": "cpu", "key": "CPU", "format": "{name}" },
    { "type": "gpu", "key": "GPU", "format": "{name}" },
    { "type": "memory", "key": "RAM" },
    { "type": "disk", "key": "Disk", "folders": "/", "format": "{size-used} / {size-total}" },
    { "type": "battery", "key": "Batt", "format": "{capacity}% ({status})" },

    "break",

    { "type": "colors", "symbol": "circle" }
  ]
}
