{
  // Half-screen layout — a vertical split on the 2560x1600 panel is around
  // 85 columns, which is not enough for config.jsonc's 54-column logo.
  //
  // The built-in `cachyos_small` art is 24 columns and 11 lines; fastfetch
  // selects it with logo.type "small" rather than by name. 24 + 4 padding +
  // 12 key column + ~35 value is about 75 columns, so this is used from 68 up.
  // Below 68 the value column starts losing characters and compact.jsonc
  // takes over.
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    // "small", not "builtin" — the small variants are not separately
    // addressable by name, they are a flag on the parent logo.
    "type": "small",
    "source": "cachyos",
    "padding": { "left": 1, "right": 3 }
  },

  "display": {
    "separator": "  ",
    "color": {
      "keys": "blue",
      "title": "magenta"
    },
    "key": {
      "type": "both",
      "width": 10
    }
  },

  // 11 logo lines, 13 module lines — the logo ends slightly above the text
  // rather than dangling below it.
  "modules": [
    "title",
    { "type": "separator", "string": "─", "times": 30 },

    { "type": "os", "key": "OS", "keyIcon": "" },
    { "type": "kernel", "key": "Kernel", "keyIcon": "", "format": "{release}" },
    { "type": "uptime", "key": "Up", "keyIcon": "" },
    { "type": "packages", "key": "Pkgs", "keyIcon": "" },
    { "type": "wm", "key": "WM", "keyIcon": "" },

    "break",

    { "type": "cpu", "key": "CPU", "keyIcon": "", "format": "{name}" },
    { "type": "gpu", "key": "GPU", "keyIcon": "", "format": "{name}" },
    { "type": "memory", "key": "RAM", "keyIcon": "" },
    { "type": "disk", "key": "Disk", "keyIcon": "", "folders": "/" },
    { "type": "battery", "key": "Batt", "keyIcon": "", "format": "{capacity}% ({status})" },

    "break",

    { "type": "colors", "symbol": "circle" }
  ]
}
