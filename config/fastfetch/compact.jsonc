{
  // Narrow layout — a thin pane, a three-way split, a TTY.
  //
  // No logo at all. With nothing to the left there is no column to protect,
  // which is why this is the one config that turns line wrap back on:
  // display.disableLinewrap defaults to true, meaning fastfetch tells the
  // terminal to clip at the right margin instead of wrapping. Clipping is
  // correct next to a logo (a wrapped line would run under the art) and wrong
  // without one, where it just silently eats the end of the CPU name.
  //
  // Keys are icons only, so the key column is 2 columns instead of 10-15.
  // That needs a Nerd Font; kitty.conf sets JetBrainsMono Nerd Font. In a
  // plain TTY the icons render as boxes — harmless, but that is the reason.
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "none"
  },

  "display": {
    "separator": " ",
    "disableLinewrap": false,
    "color": {
      "keys": "blue",
      "title": "magenta"
    },
    "key": {
      "type": "icon",
      "width": 2
    }
  },

  "modules": [
    { "type": "title", "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}" },
    { "type": "separator", "string": "─", "times": 28 },

    { "type": "os", "keyIcon": "", "format": "{pretty-name}" },
    { "type": "kernel", "keyIcon": "", "format": "{release}" },
    { "type": "uptime", "keyIcon": "" },
    { "type": "packages", "keyIcon": "" },
    { "type": "memory", "keyIcon": "" },
    { "type": "disk", "keyIcon": "", "folders": "/", "format": "{size-used} / {size-total}" },
    { "type": "battery", "keyIcon": "", "format": "{capacity}% ({status})" },

    "break",

    { "type": "colors", "symbol": "circle" }
  ]
}
