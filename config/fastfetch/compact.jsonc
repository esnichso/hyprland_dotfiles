{
  // Narrow layout — a thin pane, a three-way split, a TTY.
  //
  // No logo at all. With nothing to the left there is no column to protect,
  // which is why this is the one config that turns line wrap back on:
  // display.disableLinewrap defaults to true, meaning fastfetch tells the
  // terminal to clip at the right margin instead of wrapping. Clipping is
  // correct next to a logo (a wrapped line would run under the art) and wrong
  // without one, where it just silently eats the end of the CPU name.
  //
  // Short string keys rather than icons. An earlier version used
  // key.type "icon", which draws fastfetch's built-in Nerd Font glyph — but
  // every module here also set "keyIcon": "", and an explicit empty icon
  // overrides the built-in one. The result was a column of blank keys. Icons
  // would save two columns; they are not worth a layout that only appears
  // below 68 columns and so is the least likely of the three to get looked at.
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "none"
  },

  "display": {
    "separator": "",
    "disableLinewrap": false,
    "color": {
      "keys": "blue",
      "title": "magenta"
    },
    // 6 = len("Disk") + 2.
    "key": {
      "type": "string",
      "width": 6
    }
  },

  "modules": [
    { "type": "title", "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}" },
    { "type": "separator", "string": "─", "times": 28 },

    { "type": "os", "key": "OS", "format": "{name}" },
    { "type": "kernel", "key": "Krnl", "format": "{release}" },
    { "type": "uptime", "key": "Up" },
    { "type": "packages", "key": "Pkgs" },
    { "type": "memory", "key": "RAM" },
    { "type": "disk", "key": "Disk", "folders": "/", "format": "{size-used} / {size-total}" },
    { "type": "battery", "key": "Batt", "format": "{capacity}% ({status})" },

    "break",

    { "type": "colors", "symbol": "circle" }
  ]
}
