// ~/.config/waybar/config.jsonc
//
// Three grouped pills: workspaces left, clock centre, status right.
//
// Design rules, since you'll be looking at this all day:
//   - Everything is one neutral colour at rest. Colour means something is
//     happening — active workspace, muted audio, low battery, no network.
//   - Icons are dynamic: they change with volume level, battery level,
//     charging state and wifi signal, so the glyph alone tells you the state
//     without reading the number.
//   - Proportions are consistent: same padding, same radius, same gap.
//
// Restart after editing with SUPER+SHIFT+B. Debug with `waybar -l debug`.
{
  "layer": "top",
  "position": "top",

  "height": 36,
  "spacing": 0,

  "margin-top": 8,
  "margin-left": 12,
  "margin-right": 12,

  "modules-left": [
    "hyprland/workspaces",
    "hyprland/submap"
  ],

  "modules-center": [
    "clock"
  ],

  // Notification bell first, tray second: the tray is empty until an app puts
  // an icon in it, and GTK CSS can't style an empty widget away, so the bell
  // is the reliable left end of the group.
  "modules-right": [
    "custom/notification",
    "tray",
    "power-profiles-daemon",
    "bluetooth",
    "network",
    "backlight",
    "pulseaudio",
    "battery",
    "custom/power"
  ],

  // ---------------------------------------------------------------- left

  // Plain numbers rather than dots — a dot tells you nothing about which
  // workspace you're on, which is what made the old bar look like a stray
  // grey blob. The active one is always filled and accented (see style.css).
  "hyprland/workspaces": {
    "format": "{id}",
    "on-click": "activate",
    "sort-by-number": true,
    // Don't show workspaces that exist on another monitor.
    "active-only": false,
    "all-outputs": false,
    "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })'",
    "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })'"
  },

  // Only visible when you're inside a submap (SUPER+ALT+R). Otherwise it
  // collapses to nothing, so it costs no space at rest.
  "hyprland/submap": {
    "format": "  {}",
    "tooltip": false
  },

  // -------------------------------------------------------------- center

  "clock": {
    "format": "{:%H:%M}",
    "format-alt": "{:%a %d. %b  %H:%M}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "weeks-pos": "right",
      "format": {
        "months": "<span color='#cba6f7'><b>{}</b></span>",
        "days": "<span color='#cdd6f4'>{}</span>",
        "weeks": "<span color='#6c7086'>W{}</span>",
        "weekdays": "<span color='#7f849c'><b>{}</b></span>",
        "today": "<span color='#cba6f7'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },

  // --------------------------------------------------------------- right

  "tray": {
    "icon-size": 15,
    "spacing": 8
  },

  "custom/notification": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": "<span foreground='#f9e2af'>󰂚</span>",
      "none": "󰂜",
      "dnd-notification": "<span foreground='#f9e2af'>󰂛</span>",
      "dnd-none": "󰂛",
      "inhibited-notification": "<span foreground='#f9e2af'>󰂚</span>",
      "inhibited-none": "󰂜",
      "dnd-inhibited-notification": "<span foreground='#f9e2af'>󰂛</span>",
      "dnd-inhibited-none": "󰂛"
    },
    "return-type": "json",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },

  // Icon changes with the active profile, so you can see at a glance whether
  // you're in power-saver on battery or performance on mains.
  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Profil: {profile}",
    "tooltip": true,
    "format-icons": {
      "default": "󰗑",
      "performance": "󰓅",
      "balanced": "󰾅",
      "power-saver": "󰌪"
    }
  },

  "bluetooth": {
    "format": "󰂲",
    "format-disabled": "󰂲",
    "format-off": "󰂲",
    "format-on": "󰂯",
    "format-connected": "󰂱 {num_connections}",
    "tooltip-format": "{controller_alias}",
    "tooltip-format-connected": "{device_enumerate}",
    "on-click": "blueman-manager"
  },

  // Five signal-strength icons rather than a percentage you have to read.
  "network": {
    "format-wifi": "{icon}",
    "format-ethernet": "󰈀",
    "format-linked": "󰈀",
    "format-disconnected": "󰤭",
    "format-icons": ["󰤟", "󰤢", "󰤥", "󰤨"],
    "tooltip-format-wifi": "{essid}   {signalStrength}%\n{ipaddr}\n↓ {bandwidthDownBits}   ↑ {bandwidthUpBits}",
    "tooltip-format-ethernet": "{ifname}\n{ipaddr}",
    "tooltip-format-disconnected": "Nicht verbunden",
    // --class gives the window rule in rules.lua something to match, so this
    // opens as a floating panel instead of swallowing the screen.
    "on-click": "kitty --class tui-float -e nmtui",
    "interval": 5
  },

  "backlight": {
    "format": "{icon}",
    "format-icons": ["󰃞", "󰃟", "󰃠", "󰃡"],
    "tooltip-format": "Helligkeit {percent}%",
    "on-scroll-up": "brightnessctl -e4 -n2 set 5%+",
    "on-scroll-down": "brightnessctl -e4 -n2 set 5%-"
  },

  // Icon follows the level: low / medium / high, plus a distinct muted glyph
  // and separate icons for headphones when they're plugged in.
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟",
    "format-bluetooth": "{icon} {volume}%",
    "format-bluetooth-muted": "󰝟",
    "format-icons": {
      "headphone": ["󰋋", "󰋋", "󰋋"],
      "headset": ["󰋎", "󰋎", "󰋎"],
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-scroll-up": "wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
    "tooltip-format": "{desc}   {volume}%"
  },

  // Ten discharge icons, so the glyph itself reads as low / medium / full
  // without checking the number. Charging gets its own glyph, and the CSS
  // turns the whole pill amber below 30% and red below 15%.
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "tooltip-format": "{timeTo}\n{power} W   {health}%",
    "interval": 30
  },

  "custom/power": {
    "format": "⏻",
    "tooltip": false,
    "on-click": "~/.config/hypr/scripts/powermenu.sh"
  }
}
