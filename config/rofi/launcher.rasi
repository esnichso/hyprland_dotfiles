// Launcher theme for rofi.
//
// Colours come from the generated colors.rasi — see install/set-theme.py.
// Nothing here hard-codes a colour, so a theme switch restyles it.
//
// IMPORTANT: never put a comment inside a { } block. rofi's rasi parser
// silently discards every declaration that follows one, and the only symptom
// is "the variable 'x' failed to resolve" for the names that came after it.
// install/check-rofi.py enforces this.

@import "colors"

* {
  background-color: transparent;
  text-color:       @fg;
  font:             "Inter 12";
}

// Translucent, so the layer blur in rules.lua has something to work through.
window {
  transparency:     "real";
  location:         center;
  anchor:           center;
  width:            640px;
  background-color: @bg-a;
  border:           1px;
  border-color:     @surface1;
  border-radius:    14px;
  padding:          0px;
}

mainbox {
  children: [ inputbar, message, listview ];
  padding:  12px;
  spacing:  10px;
}

inputbar {
  children:         [ prompt, entry ];
  background-color: @bg-alt-a;
  border-radius:    10px;
  padding:          10px 14px;
  spacing:          10px;
}

prompt {
  text-color:     @accent;
  vertical-align: 0.5;
}

entry {
  placeholder:       "Suchen…";
  placeholder-color: @overlay0;
  cursor:            text;
  vertical-align:    0.5;
}

listview {
  lines:        8;
  columns:      1;
  fixed-height: false;
  scrollbar:    false;
  spacing:      2px;
}

element {
  padding:       9px 12px;
  border-radius: 10px;
  spacing:       12px;
  cursor:        pointer;
}

element normal.normal {
  text-color: @subtext0;
}

element alternate.normal {
  text-color: @subtext0;
}

// A left accent bar on the selection, echoing the active window border.
element selected.normal {
  background-color: @surface1;
  text-color:       @fg;
  border:           0px 0px 0px 3px;
  border-color:     @accent;
}

element urgent.normal {
  text-color: @urgent;
}

element-icon {
  size:           26px;
  vertical-align: 0.5;
}

element-text {
  vertical-align: 0.5;
  text-color:     inherit;
}

message {
  padding:          8px 12px;
  border-radius:    10px;
  background-color: @surface0;
}

textbox {
  text-color: @subtext0;
}
