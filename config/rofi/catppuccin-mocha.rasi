// Catppuccin Mocha theme for rofi.
//
// Deliberately matched to the rest of the desktop: same 14px corner radius as
// Waybar, same mauve→blue accent as the window borders, semi-transparent so the
// Hyprland layer blur (rules.lua) shows through.

* {
  base:     #1e1e2e;
  mantle:   #181825;
  crust:    #11111b;
  surface0: #313244;
  surface1: #45475a;
  surface2: #585b70;
  overlay0: #6c7086;
  subtext0: #a6adc8;
  text:     #cdd6f4;
  blue:     #89b4fa;
  lavender: #b4befe;
  mauve:    #cba6f7;
  red:      #f38ba8;

  background-color: transparent;
  text-color:       @text;
  font:             "Rubik 12";
}

window {
  transparency: "real";
  location:     center;
  anchor:       center;
  width:        640px;

  background-color: rgba(30, 30, 46, 0.82);
  border:           1px;
  border-color:     @surface1;
  border-radius:    14px;
  padding:          0px;
}

mainbox {
  children: [ inputbar, message, listview ];
  padding:  12px;
  spacing:  10px;
}

inputbar {
  children:         [ prompt, entry ];
  background-color: rgba(24, 24, 37, 0.7);
  border-radius:    10px;
  padding:          10px 14px;
  spacing:          10px;
}

prompt {
  text-color: @mauve;
  vertical-align: 0.5;
}

entry {
  placeholder:            "Suchen…";
  placeholder-color:      @overlay0;
  cursor:                 text;
  vertical-align:         0.5;
}

listview {
  lines:        8;
  columns:      1;
  fixed-height: false;
  scrollbar:    false;
  spacing:      2px;
}

element {
  padding:       9px 12px;
  border-radius: 10px;
  spacing:       12px;
  cursor:        pointer;
}

element normal.normal   { text-color: @subtext0; }
element alternate.normal { text-color: @subtext0; }

element selected.normal {
  background-color: @surface1;
  text-color:       @text;
  // Left accent bar on the selection, matching the active window border.
  border:           0px 0px 0px 3px;
  border-color:     @mauve;
}

element urgent.normal {
  text-color: @red;
}

element-icon {
  size:           26px;
  vertical-align: 0.5;
}

element-text {
  vertical-align: 0.5;
  text-color:     inherit;
}

message {
  padding:          8px 12px;
  border-radius:    10px;
  background-color: rgba(49, 50, 68, 0.6);
}

textbox {
  text-color: @subtext0;
}
