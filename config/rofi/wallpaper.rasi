// Wallpaper picker — used by config/hypr/scripts/wallpaper.sh pick.
//
// A grid of thumbnails rather than a list: you pick a wallpaper by looking at
// it, not by reading filenames.
//
// Imports the launcher rather than the palette directly. That is deliberate:
// the launcher declares the `* { }` block that sets every widget transparent
// by default. Without it rofi falls back to its built-in defaults, which are
// LIGHT — so any widget you don't explicitly style renders white on a dark
// desktop. Importing here also keeps the two dialogs visually consistent.
//
// Never put a comment inside a { } block: rofi discards everything after it.

@import "launcher"

window {
  transparency:     "real";
  location:         center;
  anchor:           center;
  width:            60%;
  height:           55%;
  background-color: @bg-a;
  border:           1px;
  border-color:     @surface1;
  border-radius:    14px;
}

mainbox {
  children: [ inputbar, listview ];
  padding:  14px;
  spacing:  12px;
}

entry {
  placeholder:       "Filtern…";
  placeholder-color: @overlay0;
  vertical-align:    0.5;
}

// The grid. 4 across is a good balance at 60% width on a 16" panel.
listview {
  layout:       vertical;
  columns:      4;
  lines:        3;
  spacing:      10px;
  scrollbar:    false;
  fixed-height: false;
}

element {
  orientation:      vertical;
  padding:          8px;
  spacing:          6px;
  border-radius:    10px;
  cursor:           pointer;
  background-color: transparent;
}

// The thumbnail: rofi renders the image passed via the dmenu icon protocol.
element-icon {
  size:             160px;
  horizontal-align: 0.5;
}

element-text {
  horizontal-align: 0.5;
  vertical-align:   0.5;
  text-color:       inherit;
}

element normal.normal {
  text-color: @subtext0;
}

element selected.normal {
  background-color: @surface1;
  text-color:       @fg;
  border:           2px;
  border-color:     @accent;
}
